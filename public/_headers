# Content-hashed build output: safe to freeze forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos. 30 days, deliberately NOT immutable: these filenames are not
# content-hashed, so a replaced photo must be renamed (hero-ponte-v2.webp)
# or purged at the edge.
/images/*
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=604800

/icon.svg
  Cache-Control: public, max-age=604800

# Crawler files: short TTL so a sitemap fix propagates quickly.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# Security headers for every response.
# Cache-Control is deliberately absent here: matching rules are merged and
# duplicate headers are joined with commas, which would produce a doubled
# Cache-Control on the paths above. HTML keeps the Workers default of
# `public, max-age=0, must-revalidate`, which is what we want anyway.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Keep the preview host out of the index. An indexed *.workers.dev copy is
# duplicate content competing with the canonical domain in local search.
https://:project.:account.workers.dev/*
  X-Robots-Tag: noindex, nofollow
